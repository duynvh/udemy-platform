# Local development values for infra/compose.yaml.
# Copy this file to infra/.env (ignored by Git) and change the values.
# Never use these values outside your own machine.

# PostgreSQL: admin user (container setup) and application user (backend, least privilege)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-postgres-admin
MARKETPLACE_DB_USER=marketplace
MARKETPLACE_DB_PASSWORD=local-marketplace

# Valkey (Redis API)
VALKEY_PASSWORD=local-valkey

# Kafka SASL/PLAIN users: "broker" (inter-broker) and "marketplace" (applications)
KAFKA_BROKER_PASSWORD=local-kafka-broker
KAFKA_APP_PASSWORD=local-kafka-app

# OpenSearch user "admin". Rule: 8+ characters with upper case, lower case, a digit, and a special character.
OPENSEARCH_ADMIN_PASSWORD=Local-Opensearch-2026

# RustFS (S3 API)
RUSTFS_ACCESS_KEY=marketplace-admin
RUSTFS_SECRET_KEY=local-rustfs-secret
